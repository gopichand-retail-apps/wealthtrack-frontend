{
  "name": "wealthtrack-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5901 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \".github/workflows/*.yml\" \"*.ts\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \".github/workflows/*.yml\" \"*.ts\" \"*.js\"",
    "test:unit": "vitest run",
    "test:cov": "vitest run --coverage",
    "preview": "vite preview --host 127.0.0.1 --port 5901 --strictPort",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
